
# Create a new directory and enter it
function mkd() {
	mkdir -p "$@" && cd "$_";
}

# Change working directory to the top-most Finder window location
function cdf() { # short for `cdfinder`
	cd "$(osascript -e 'tell app "Finder" to POSIX path of (insertion location as alias)')";
}

# Determine size of a file or total size of a directory
function fs() {
	if du -b /dev/null > /dev/null 2>&1; then
		local arg=-sbh;
	else
		local arg=-sh;
	fi
	if [[ -n "$@" ]]; then
		du $arg -- "$@";
	else
		du $arg .[^.]* ./*;
	fi;
}

# `o` with no arguments opens the current directory, otherwise opens the given
# location
function o() {
	if [ $# -eq 0 ]; then
		open .;
	else
		open "$@";
	fi;
}

# Commit everything like no one's watching
lmfao() {
	git add .
	if [[ "$1" == "" ]]
	then
		git commit -m "commit"
		git push
	else
		git commit -m "$1"
		git push
	fi
}


# Download a youtube video as mp3
mp3() {
	yt-dlp -f 'ba' -x --audio-format mp3 "$1"  -o '%(title)s.%(ext)s'
}

# ls last n by modification date
lt() {
	if [[ "$1" == "" ]]
	then
		ls -t | head -10
	else
		ls -t | head -"$1"
	fi 
}

# Remove the password from a pdf: pdfunlock <file.pdf> <password> -> file_unlocked.pdf
pdfunlock() {
	if [[ "$1" == "" || "$2" == "" ]]
	then
		echo "usage: pdfunlock <file.pdf> <password>"
		return 1
	fi
	qpdf --password="$2" --decrypt "$1" "${1:r}_unlocked.pdf"
	local rc=$?
	# qpdf exits 3 on success with warnings (common on malformed bank pdfs)
	if [[ $rc -eq 0 || $rc -eq 3 ]]
	then
		echo "unlocked: ${1:r}_unlocked.pdf"
	else
		echo "pdfunlock failed (qpdf exit $rc — wrong password?)" >&2
		return $rc
	fi
}
